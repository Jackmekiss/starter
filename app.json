{
  "expo": {
    "name": "starter",
    "slug": "starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "starter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jackmekiss.starter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jackmekiss.starter"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Poppins",
                "fontDefinitions": [
                  {
                    "path": "./public/fonts/Poppins_100Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./public/fonts/Poppins_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./public/fonts/Poppins_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./public/fonts/Poppins_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./public/fonts/Poppins_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./public/fonts/Poppins_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./public/fonts/Poppins_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./public/fonts/Poppins_900Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./public/fonts/Poppins_100Thin.ttf",
              "./public/fonts/Poppins_300Light.ttf",
              "./public/fonts/Poppins_400Regular.ttf",
              "./public/fonts/Poppins_500Medium.ttf",
              "./public/fonts/Poppins_600SemiBold.ttf",
              "./public/fonts/Poppins_700Bold.ttf",
              "./public/fonts/Poppins_800ExtraBold.ttf",
              "./public/fonts/Poppins_900Black.ttf"
            ]
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
